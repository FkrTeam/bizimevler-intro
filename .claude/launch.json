{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4181",
        "--strictPort"
      ],
      "port": 4181
    },
    {
      "name": "wrangler",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--port",
        "8787",
        "--ip",
        "127.0.0.1"
      ],
      "port": 8787
    },
    {
      "name": "preview-split",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--outDir",
        "dist-intro-r1",
        "--port",
        "4182",
        "--strictPort"
      ],
      "port": 4182
    }
  ]
}